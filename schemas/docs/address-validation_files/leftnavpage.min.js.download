}

// Version Log Tab functionality for Left Navigation
$(document).ready(function() {
    // Step 1: Get API group name from hidden input
    var groupName = $('#current-api-group').val();
    if (groupName) {
        // Step 2: Fetch DeprecatedVersion-Guide.json
        var baseUrl = window.location.hostname === "localhost" ? (window.wircOrigin || "") : "";
        $.getJSON(baseUrl + '/wirc/json/api_groups/DeprecateVersion-Guide.json', function(guide) {
            var groupData = guide[groupName];
            if (groupData && groupData.version_log) {
                // Step 3: Insert Version Log tab if not present
                if ($('.nav-tabs .tabWB.webhook-content').length === 0) {
                    // Insert tab header
                    var versionTab = $('<li><a class="tabWB webhook-content" aria-label="Version Log" data-target="#version-log" href="#version-log" data-toggle="tab">Version Log</a></li>');
                    $('.nav-tabs').append(versionTab);
                }
                // Ensure .tab-content exists
                if ($('.tab-content').length === 0) {
                    // If .tab-content does not exist, create it after nav-tabs
                    $('<div class="tab-content"></div>').insertAfter('.nav-tabs');
                }
                // Insert tab content panel if not present
                if ($('#version-log').length === 0) {
                    var versionPanel = $('<article class="tab-pane" id="version-log"></article>');
                    $('.tab-content').append(versionPanel);
                }
                // Step 4: Populate the Version Log tab content
                var tableHtml = createVersionLogTableFromAPI(groupData.version_log);
                // If this is the only tab or should be active, add 'active in' classes
                var $versionLogPanel = $('#version-log');
                if ($('.tab-content .tab-pane.active').length === 0) {
                    $versionLogPanel.addClass('active in');
                }
                $versionLogPanel.html('<div class="api-version-log-table"><div class="api-version-log-heading">Version Log</div><div id="api-table-container">' + tableHtml + '</div></div>');
            }
        });
    }
});

// Function to create version log table HTML from version_log array
function createVersionLogTableFromAPI(versionLogData) {
    var html = '<table>';
    html += '<thead><tr>';
    html += '<th>API END POINT NAME</th>';
    html += '<th>VERSION</th>';
    html += '<th>DATE INTRODUCED</th>';
    html += '<th>STATUS</th>';
    html += '<th>SUPPORT END DATE</th>';
    html += '</tr></thead><tbody>';

    // Generate table rows from version_log array
    versionLogData.forEach(function (item) {
        html += '<tr>';
        html += '<td>' + (item.name || 'Unknown API') + '</td>';
        html += '<td>' + (item.version || 'V1') + '</td>';
        html += '<td>' + (item.date_introduced || 'N/A') + '</td>';

        // Status cell with icon
        html += '<td class="status-cell">';
        if (item.status === 'Active') {
            html += '<img src="/api/content/dam/fedex-com/irc/common/api-active-icon.png" alt="Active" class="status-icon-img"> Active';
        } else if (item.status === 'Deprecated') {
            html += '<img src="/api/content/dam/fedex-com/irc/common/api-depricated-icon.png" alt="Deprecated" class="status-icon-img"> Deprecated';
        } else {
            html += item.status || '';
        }
        html += '</td>';

        html += '<td>' + (item.support_end_date || 'N/A') + '</td>';
        html += '</tr>';
    });

    html += '</tbody></table>';

    return html;
}

function buildDynamicLeftNavFromAccordions() {
    if (document.querySelector('.acc-leftnav-config')) {
        window.FDX = window.FDX || {};
        window.FDX.LEFTNAV = window.FDX.LEFTNAV || {};

        function highlightElement(el, selectorToClear) {
            document.querySelectorAll(selectorToClear).forEach(s => s.classList.remove('highlight'));
            el.classList.add('highlight');
            setTimeout(() => el.classList.remove('highlight'), 1200);
        }

        window.FDX.LEFTNAV.dynamicAccordionNavSelection = function(obj, selector) {
            document.querySelectorAll('ul.fxg-child-links.custom-dynamic-accordion a.dynamic-nav-link').forEach(link => link.classList.remove('current'));
            if (obj && obj.classList) obj.classList.add('current');

            const sectionIndex = selector - 19;
            const sectionClass = 'leftnav-selection' + sectionIndex;
            const section = document.querySelector('.' + sectionClass);

            if (section) {
                const panel = section.querySelector('.collapse');
                if (panel && typeof $ !== 'undefined' && typeof $(panel).collapse === 'function') {
                    $(panel).collapse('show');
                }
                section.scrollIntoView({ behavior: 'smooth', block: 'start' });
                highlightElement(section, '.fxg-accordion-selector');
                return;
            }

            const targetElement = document.querySelector(`a[href="#${selector}"]`);
            if (targetElement) {
                const parentPanel = targetElement.closest('.collapse');
                if (parentPanel && typeof $ !== 'undefined' && typeof $(parentPanel).collapse === 'function') {
                    $(parentPanel).collapse('show');
                }
                targetElement.scrollIntoView({ behavior: 'smooth', block: 'start' });
                highlightElement(targetElement, 'ul.fxg-child-links.custom-dynamic-accordion a.dynamic-nav-link');
            }
        };

        setTimeout(function() {
            if (typeof $ === 'undefined' || typeof jQuery === 'undefined') {
                return;
            }

            $(".menu-txt").hide();
            $("#main-menu-link").show();
            $(".child-nav-links").hide();

            const titles = [];
            const selectors = document.querySelectorAll('.fxg-accordion-selector .accordian-selector');

            selectors.forEach(function(anchor, idx) {
                const orderSpan = anchor.querySelector('.fxg-accordion-order-number');
                let title = '';

                if (orderSpan && orderSpan.nextSibling) {
                    let node = orderSpan.nextSibling;
                    while (node && node.nodeType === Node.TEXT_NODE && !node.textContent.trim()) {
                        node = node.nextSibling;
                    }
                    if (node && node.nodeType === Node.TEXT_NODE) {
                        title = node.textContent.trim();
                    } else if (node && node.nodeType === Node.ELEMENT_NODE) {
                        title = node.textContent.trim();
                    }
                }

                if (!title) {
                    title = anchor.textContent.replace(orderSpan ? orderSpan.textContent : '', '').trim();
                }

                if (title) {
                    titles.push({
                        order: orderSpan ? orderSpan.textContent.trim() : (idx + 1),
                        title: title
                    });
                }
            });

            const menuDiv = document.getElementById('gettingstartedMenuDiv');
            if (!menuDiv) return;

            const externalLibraryContent = menuDiv.querySelector('ul.fxg-child-links.dynamic-accordion:not(.custom-dynamic-accordion)');
            if (externalLibraryContent && externalLibraryContent.children.length > 0) {
                return;
            }

            let staticTitle = '';
            const fxgTitle = document.querySelector('.title.section .fxg-title');
            if (fxgTitle && fxgTitle.textContent) {
                staticTitle = fxgTitle.textContent.trim().toUpperCase();
            } else {
                const h1 = document.querySelector('.title.section h1');
                if (h1 && h1.textContent) {
                    staticTitle = h1.textContent.trim().toUpperCase();
                }
            }

            let titleA = menuDiv.querySelector('#gert-started-id');
            if (!titleA) {
                titleA = document.createElement('a');
                titleA.id = 'gert-started-id';
                titleA.style.fontWeight = 'bold';
                menuDiv.appendChild(titleA);
            }
            titleA.textContent = staticTitle;
            titleA.style.display = 'block';

            let hr = menuDiv.querySelector('#hrid');
            if (!hr) {
                hr = document.createElement('div');
                hr.id = 'hrid';
                hr.className = 'leftnav-hr';
                hr.innerHTML = '<hr>';
                menuDiv.insertBefore(hr, titleA);
            } else {
                hr.style.display = 'block';
            }

            menuDiv.querySelectorAll('ul.fxg-child-links').forEach(ul => ul.style.display = 'none');

            let ul = menuDiv.querySelector('ul.fxg-child-links.custom-dynamic-accordion');
            if (!ul) {
                ul = document.createElement('ul');
                ul.className = 'fxg-child-links custom-dynamic-accordion';
                ul.setAttribute('data-builder', 'custom-dynamic');
                menuDiv.appendChild(ul);
            }
            ul.style.display = 'block';
            ul.innerHTML = '';

            titles.forEach(function(item, i) {
                const currentClass = i === 0 ? 'current' : '';
                const id = 'dynamic-nav-item-' + (20 + i);
                const dataTarget = 'leftnav-selection' + (i + 1);
                ul.innerHTML += `<li><a id="${id}" onclick="FDX.LEFTNAV.dynamicAccordionNavSelection(this,${20 + i})" data-target="${dataTarget}" class="${currentClass} dynamic-nav-link"><div class="child-wrapper"><span class="fxg-leftnav-order-number">${item.order}</span><div class="child-text">${item.title}</div></div></a></li>`;
            });
        }, 500);
    }
}

