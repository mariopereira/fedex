$(document).ready(function () {
    var btn = $('.fdp-btn-back-to-top');
    if (btn) {
        $(window).scroll(function () {
            if ($(window).scrollTop() > 300) {
                btn.addClass('show');
            } else {
                btn.removeClass('show');
            }
        });

        btn.on('click', function (e) {
            e.preventDefault();
            $('html, body').animate({ scrollTop: 0 }, '300');
        });
    }
});

/**
 * Authentication and Authorization check for Catalog Overview pages
 */

if (!FDX) {
    var FDX = {};
}

FDX.CATALOG_OVERVIEW_AUTH = {
    
    /**
     * Initializes authentication check for catalog pages
     * Routes private APIs to access verification, public APIs to subscription check
     */
    init: function() {
        var othis = this;
        
        if (othis.isprivateAPI()) {
            if (FDX.SESSION.userAuthenticated) {
                othis.checkUserAccess();
            } else {
                othis.displayunAuthorizeMessage();
            }
        } else {
            if (othis.hassubscriptionAccess()) {
                othis.loadCatalog();
            } else {
                othis.displayunAuthorizeMessage();
            }
        }
    },
    
    /**
     * Checks if the current API is marked as private
     * @returns {boolean} true if API is private, false otherwise
     */
    isprivateAPI: function() {
        return $("#private-api").val() === "true";
    },
    
    /**
     * Checks if user has subscription access (webhook validation)
     * @returns {boolean} true if user has access, false otherwise
     */
    hassubscriptionAccess: function() {
        var hasAccess = true;
        if (location.href.indexOf("webhook") !== -1) {
            var webhookFlags = JSON.parse(localStorage.getItem("webhookFlags"));
            hasAccess = webhookFlags != null && webhookFlags != undefined;
        }
        return hasAccess;
    },
    
    /**
     * Loads catalog content by showing main content area
     */
    loadCatalog: function() {
        this.showMainContent();
    },
    
    /**
     * Displays unauthorized access message and hides content
     * Shows different messages based on authentication status and context
     * Messages are configured in global-navigation per locale
     */
    displayunAuthorizeMessage: function() {
        var developerURL = $("#docs_developer").attr("href");
        var errorMessage = "";
        
        if (!FDX.SESSION.userAuthenticated) {
            errorMessage = "<h2>" + $("#error-msg-login").val() + "</h2>";
        } else if (location.href.indexOf("webhook") != -1) {
            errorMessage = "<h2>" + $("#error-msg-unauthorized").val() + "</h2>" + 
                          "<p>" + $("#error-msg-unauthorized-desc").val() + "</p>";
        } else {
            errorMessage = "<h2>" + $("#error-msg-no-access").val() + "</h2>" + 
                          "<p>" + $("#error-msg-no-access-desc").val() + " " + 
                          "<a href='" + developerURL + "'>" + $("#error-msg-support-link").val() + "</a>.</p>";
        }
        
        $("#error-info-page").show().html(errorMessage);
        this.hideMainContent();
        $("#parsysDiv").addClass("auth-error-spacing");
    },
    
    /**
     * Checks if user has access to the API by making server-side verification calls
     * Attempts two API calls: first with "_Product" suffix, then without
     */
    checkUserAccess: function() {
        if (!FDX.TOPNAV.apiURL || FDX.TOPNAV.apiURL === "") {
            FDX.TOPNAV.apiURL = $("#apigURL").val();
        }
        var othis = this;
        
        othis.callIrcpAPI("_Product")
            .then(function(access) {
                if (!access) {
                    return othis.callIrcpAPI("");
                }
                return access;
            })
            .then(function(access) {
                if (access) {
                    othis.loadCatalog();
                } else {
                    othis.displayunAuthorizeMessage();
                }
            })
            .catch(function(error) {
                $("#commonErrorMsg").modal();
            });
    },
    
    /**
     * Makes API call to verify if user has the API in their project
     * @param {string} productString - Suffix to append to API name ("_Product" or "")
     * @returns {Promise<boolean>} Promise resolving to true if user has access, false otherwise
     */
    callIrcpAPI: function(productString) {
        var othis = this;
        return new Promise(function(resolve, reject) {
            var apiUrl = 'https://' + FDX.TOPNAV.apiURL + '/irc/v1/projects?apiGroupName=' + encodeURIComponent(othis.getAPIName() + productString);
            
            $.ajax({
                type: 'GET',
                url: apiUrl,
                dataType: 'json',
                headers: {
                    'Authorization': 'Bearer ' + othis.getToken()
                },
                success: function(msg, status, xhr) {
                    if (msg.output != undefined) {
                        var data = msg.output;
                        if (data.projects != undefined) {
                            for (var i = 0; i < data.projects.length; i++) {
                                if (data.projects[i].apiProduct != undefined) {
                                    if (data.projects[i].apiProduct.inTest || data.projects[i].apiProduct.inProd) {
                                        resolve(true);
                                        return;
                                    }
                                }
                            }
                        }
                    }
                    resolve(false);
                },
                error: function(xhr, status, error) {
                    reject();
                }
            });
        });
    },
    
    /**
     * Gets the API name from hidden input field
     * @returns {string} The API name
     */
    getAPIName: function() {
        return $("#api-name").val();
    },
    
    /**
     * Retrieves authentication token from localStorage
     * @returns {string} Bearer token or empty string if not found
     */
    getToken: function() {
        try {
            var tokenData = localStorage.getItem("loginTokenStorage");
            if (tokenData) {
                var obj = JSON.parse(tokenData);
                if (obj && obj.token) {
                    return obj.token;
                }
            }
        } catch (e) {
            // Handle JSON parsing errors silently
        }
        return "";
    },
    
    /**
     * Hides main content including body, breadcrumbs, and banner
     */
    hideMainContent: function() {
        $(".body-content").css("display", "none");
        $(".breadcrumb-irc-container").css("display", "none");
        $(".banner-image").css("display", "none");
    },
    
    /**
     * Shows main content and hides error message
     * Resets CSS positioning applied during error display
     */
    showMainContent: function() {
        $(".body-content").show();
        $(".breadcrumb-irc-container").show();
        $(".banner-image").show();
        $("#error-info-page").hide();
        $("#parsysDiv").removeClass("auth-error-spacing");
    }
};

// Initialize on document ready
$(document).ready(function() {
    if ($("#private-api").length === 0) {
        return;
    }
    
    var currentPath = window.location.pathname;
    var isCatalogPage = currentPath.indexOf("/catalog/") !== -1;
    
    if (!isCatalogPage) {
        return;
    }
    
    FDX.CATALOG_OVERVIEW_AUTH.init();
});

