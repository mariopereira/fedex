/**
 * Maps developer environment hostnames to their corresponding API URLs
 * @returns {string} The appropriate API URL for the current environment
 */
function getCodedAPI() {
    // Environment hostnames
    const L1_HOST = 'developerbase.idev.fedex.com';
    const L2_HOST = 'developerdev.idev.fedex.com';
    const L3_HOST = 'developerdrt.idev.fedex.com';
    const L4_HOST = 'developerstress.dmz.idev.fedex.com';
    const L6_HOST = 'developertest.fedex.com';
    const LP_HOST = 'developer.fedex.com';
    
    // Corresponding API URLs
    const L1_API_URL = "apis-base.idev.fedex.com";
    const L2_API_URL = "apis-dev.idev.fedex.com";
    const L3_API_URL = 'apis-drt.idev.fedex.com';
    const L4_API_URL = 'apis-stress.idev.fedex.com';
    const L6_API_URL = 'apistest.fedex.com';
    const LP_API_URL = 'apis.fedex.com';

    // Environment-based API URL configuration
    const ENVIRONMENT_CONFIG = new Map([
        // Development environments - all use DRT API
        [L1_HOST, L3_API_URL],
        [L2_HOST, L3_API_URL],
        [L3_HOST, L3_API_URL],

        // Stress testing environment
        [L4_HOST, L4_API_URL],

        // Testing environment
        [L6_HOST, L6_API_URL],

        // Production environment
        [LP_HOST, LP_API_URL]
    ]);
    
    const currentHostname = window?.location?.hostname;
    
    // Return mapped URL or fallback
    return ENVIRONMENT_CONFIG.get(currentHostname) || LP_API_URL;
}



