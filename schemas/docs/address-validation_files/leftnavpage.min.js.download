}

function getUrlVars(){
  var vars = {};
  var parts = window.location.href.replace(/[?&]+([^=&]+)=([^&]*)/gi, function(m,key,value){
    vars[key]=value;
  });  
  return JSON.parse(decodeURI(JSON.stringify(vars)));
}

