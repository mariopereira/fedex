function formatOrderFormFileName(fileName) {
    if (!fileName) {
        return '';
    }
    return fileName
        .replace(/-/g, ' ')
        .replace(/_/g, ' - ')
        .replace(/ (\w+)(\.\w+)$/, '_$1$2');
}

function uploadProjectDocuments(projectId, onCompleteCallback) {
    showloaderimg();
    var firstName = FDX.TOPNAV?.userDetails?.["firstName"] || "";
    var lastName = FDX.TOPNAV?.userDetails?.["lastName"] || "";
    var requestedBy = firstName + ' ' + lastName;
    var pdfPathList = [];
    
    // Check both acceptTerms-block (for proprietary/thirdparty) and ppcContent (for proprietarypc)
    var checkboxSelectors = '.acceptTerms-block input[type="checkbox"]:checked, .ppcContent input.projlicense:checked';
    
    $(checkboxSelectors).each(function() {
        var $label = $(this).closest('label');
        $label.find('a[href]').each(function() {
            var href = $(this).attr('href');
            if (href) {
                // Replace .html extension specifically (not all occurrences of .html in path)
                if (href.indexOf('.html') > -1) {
                    href = href.replace(/\.html(?=[?#]|$)/, '.viewAs.pdf');
                }
                // Only add URLs that contain 'legal' in the path
                if ((href.indexOf('.pdf') > -1 || href.indexOf('.viewAs') > -1) && href.toLowerCase().indexOf('legal') > -1) {
                    pdfPathList.push(href);
                }
            }
        });
    });
    
    if (pdfPathList.length === 0) {
        if (typeof onCompleteCallback === 'function') {
            onCompleteCallback();
        }
        return;
    }
    
    var obj = JSON.parse(localStorage.getItem("loginTokenStorage"));
    if (!obj || !obj.token) {
        if (typeof onCompleteCallback === 'function') {
            onCompleteCallback();
        }
        return;
    }
    
   
    
    // Fetch agreement version data from legal doc version servlet before uploading
    var legalBasePath = '';
    $.each(pdfPathList, function(index, url) {
        var legalIndex = url.toLowerCase().indexOf('/legal/');
        if (legalIndex > -1) {
            legalBasePath = url.substring(0, legalIndex + '/legal'.length);
            return false; // exit loop after first match
        }
    });
    
    if (legalBasePath) {
        $.ajax({
            type: 'GET',
            url: legalBasePath + '.legaldocversion.json',
            dataType: 'json',
            timeout: 10000
        }).done(function(versionData) {
            proceedWithUpload(versionData);
        }).fail(function() {
            // If version fetch fails or times out, proceed without version data
            proceedWithUpload({});
        });
    } else {
        proceedWithUpload({});
    }
    
    function proceedWithUpload(versionData) {
        var fetchPromises = [];
        var fetchBlob = function(url) {
            return new Promise(function(resolve, reject) {
                var xhr = new XMLHttpRequest();
                xhr.open('GET', url, true);
                xhr.responseType = 'blob';
                xhr.setRequestHeader('Cache-Control', 'no-cache, no-store, must-revalidate');
                xhr.setRequestHeader('Pragma', 'no-cache');
                xhr.onload = function() {
                    if (xhr.status === 200 || xhr.status === 304) {
                        resolve(xhr.response);
                    } else {
                        reject(xhr.statusText);
                    }
                };
                xhr.onerror = function() {
                    reject(xhr.statusText);
                };
                xhr.send();
            });
        };
        
        $.each(pdfPathList, function(index, url) {
            fetchPromises.push(fetchBlob(url));
        });
        
        Promise.all(fetchPromises).then(function(blobs) {
            var formData = new FormData();
            
            $.each(blobs, function(index, blob) {
                if (blob && blob.size > 0) {
                    var fileName = pdfPathList[index].split('/').pop();
                    
                    // Validate filename before processing
                    if (!fileName) {
                        return; // Skip if no filename
                    }
                    
                    // Strip query string and hash fragment once so downstream
                    // formatting and version lookup operate on the same value
                    fileName = fileName.split('?')[0].split('#')[0];
                    
                    // Remove .viewAs from filename
                    fileName = fileName.replace('.viewAs', '');
                    
                    // Format the filename
                    var formattedFileName = formatOrderFormFileName(fileName);
                    
                    // Skip if filename couldn't be formatted or is empty
                    if (!formattedFileName) {
                        return; // continue to next iteration
                    }
                    
                    // Append agreement version to filename if available
                    var childPageName = fileName.replace(/\.pdf$/i, '');
                    var docVersion = versionData[childPageName];
              
                    if (docVersion && docVersion.version) {
                        var safeVersion = docVersion.version.replace(/[^A-Za-z0-9._-]/g, '');
                        var extIndex = formattedFileName.lastIndexOf('.');
                        if (extIndex > -1 && safeVersion) {
                            formattedFileName = formattedFileName.substring(0, extIndex)
                                + '_' + safeVersion
                                + formattedFileName.substring(extIndex);
                        }
                    } 
                    formData.append('documents', blob, formattedFileName);
                }
            });
            
            // Check if formData has any documents before uploading
            var hasDocuments = false;
            for (var pair of formData.entries()) {
                if (pair[0] === 'documents') {
                    hasDocuments = true;
                    break;
                }
            }
            
            if (!hasDocuments) {
                if (typeof onCompleteCallback === 'function') {
                    onCompleteCallback();
                }
                return;
            }
            
            var uploadUrl = 'https://' + (apiUrl || FDX.TOPNAV.apiURL) + '/irc/v1/project/' + projectId + '/document/upload';
            var params = 'documentType=proj&reasonForAction=upload&requestedBy=' + encodeURIComponent(requestedBy);
            
            $.ajax({
                type: 'PUT',
                crossDomain: true,
                url: uploadUrl + '?' + params,
                data: formData,
                processData: false,
                contentType: false,
                xhrFields: {
                    withCredentials: true
                },
                headers: {
                    'Authorization': 'Bearer ' + obj.token
                },
                success: function(response) {
                    // Document upload successful
                    hideloaderimge();
                    if (typeof onCompleteCallback === 'function') {
                        onCompleteCallback();
                    }
                },
                error: function(jqXHR) {
                    // Document upload failed
                    hideloaderimge();
                    $("#commonErrorMsg").modal();
                    if (typeof onCompleteCallback === 'function') {
                        onCompleteCallback();
                    }
                }
            });
        }).catch(function(error) {
            // Error fetching PDF blobs
            hideloaderimge();
            $("#commonErrorMsg").modal();
            if (typeof onCompleteCallback === 'function') {
                onCompleteCallback();
            }
        });
    }
}

function projconfirmation(data, status) {
	hideloaderimge();
	var x = document.getElementsByClassName("tab");
    localStorage.removeItem("createproj");
	if (status === 400) {
		if (data.error.errors.length != 0) {
            const errorCode = data?.error?.errors?.[0]?.code || status;
            const errorMessage = `${errorCode}: ${
              data?.error?.errors?.[0]?.message || data?.message
            }`;
            // gdl error tracking for project creation failure
            if (window.FDX && window.FDX.GDL) {
                window.FDX.GDL.push([
                    "event:publish",
                    [
                        "error",
                        "error",
                        {
                            type: 'server',
                            source: 'Create Project',
                            message: errorMessage
                        }
                    ]
                ]);
            }
			if (data.error.errors[0].code.toLowerCase() == "PROJECTNAME.VIOLATESUNIQUENESS"
					.toLowerCase()) {
				$("#projectlabel").css('color', '#e8002e');

				$(".projUniqueNameerrmsg").show();	
                $("#otherApiprojectName").addClass("redtextbox");
                if(FDX.TOPNAV.userType=="proprietarypc"){
                    $(".ppc_projUniqueNameerrmsg").show();
                nextPrev(-1);
                    $("#projectName").addClass('redtextbox');
                }
				$("#projectName").focus();                
			} else
				$("#commonErrorMsg").modal();
			
		}
		//document.getElementsByClassName("numbercircle")[currentTab].classList.remove("finish");
} else if (status === 200) {		
		if (data) //data.Status == "Created"
		{
			if (data.output.length != 0) {
                var projectname =  $("#projectName").val();
				$("#key").val(data.output["keySecret"]);
				projectUUID = data.output.projectUuid;
				keyId = data.output.sandboxKeyId;
				FDX.LEFTNAV.storeProjectDetails(projnameDisplay,
						projectUUID);				
				var imageObj = $("#prj_succ_img");
				var imagePath= imageObj.attr('data-rendition');
				imageObj.attr('src', imagePath);
				var projcret = $("#projectcreated").text();
	             projcret = projcret.replace('{{name}}', projnameDisplay);
                $("#projectcreated").html(projcret);
                $("#projectcreated").attr('aria-label', projcret);
                               
                var fclEmail = notifications["emailId"] ? notifications["emailId"] : FDX.TOPNAV.userDetails["email"];

		        if(FDX.TOPNAV.userType=="proprietarypc")
				{
                    console.log("proprietarypc user detected");
                    showloaderimg();
                    enrollNotifications();
                    uploadProjectDocuments(projectUUID, function() {
                        $("#confirmation").modal();
                    });
				}
                if(notifications != undefined)
                {
                	if(notifications.outageNotificationFlg)
                		$(".shipping-notifications #outage-notifications").prop("checked",true);	                	                	
                	if(notifications.apiupdateNotificaitonFlg)
                		$(".shipping-notifications #api-notifications").prop("checked",true);	                	
                }
                /*
                 * Sending to Next Screen
                 */             
                x[currentTab].style.display = "none";                
      		  	currentTab = currentTab + currentIndex;      		  	
      		  	showTab(currentTab);                 		
			}
			else
			{
				document.getElementsByClassName("numbercircle")[currentTab].classList.remove("finish");
				$("#commonErrorMsg").modal();				
			}			
		} else {
			document.getElementsByClassName("numbercircle")[currentTab].classList.remove("finish");
			$("#commonErrorMsg").modal();
		}
		
	}

}

function validateprojForm() {
	var x, y, z, i, valid = true;
	var $regexname=/^\d*\s*[a-zA-Z]\s*[a-zA-Z0-9]*/;
	x = document.getElementsByClassName("tab-validate");
	y = x[currentTab].getElementsByTagName("input");
	for (i = 0; i < y.length; i++) {
	namelen = y[i].value.length;
	if (y[i].value == "" || namelen > 48) {
	y[i].className += " invalid";
	$(".fxg-proj-error-msg").show().html(
	namelen > 48 ? projnoofcharacters : projblank);
	$("#projectlabel").css('color', '#e8002e');
	valid = false;
	} else if(currentTab == 1 && !isNaN(y[i].value)){
	          y[i].className += " invalid";
	      $(".fxg-proj-error-msg").show().html("<span class='cross-icon'></span> "+$("#prjnamevalidation").val());
	  $("#projectlabel").css('color', '#e8002e');
	          valid = false;
	        }
	}
	if (valid) {
        $(".fxg-proj-error-msg").hide();
        $(".form-group input").removeClass("invalid");
        $("#projectlabel").css('color', '#333333');
		document.getElementsByClassName("numbercircle")[currentTab].className += " finish";
        var ele=document.getElementsByClassName('swatch')[currentTab];
        if(typeof ele!="undefined"){
          document.getElementsByClassName("swatch")[currentTab].className += " finish";}
	}
	return valid; // return the valid status
}

