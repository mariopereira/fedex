						"example": "GTIN 00000006"
					},
					"nonStandardManufacturerProductId": {
						"maxLength": 70,
						"type": "string",
						"description": "Manufacturer Non-Standard Product Identifier per commodity - A manufacturer or product supplier’s unique product code, provided to sellers who must supply it for customs declaration.</br>Maximum length is 70.<br> Example: SH123456-L\n",
						"example": "SH123456-L"
					},
					"merchantProductId": {
						"maxLength": 70,
						"type": "string",
						"description": "Merchant Product Identifier (shipper SKU/item ID) per commodity - The merchant’s unique code to identify goods, usually the SKU, item code or product code.</br>Maximum length is 70.<br> Example: 12345\n",
						"example": "12345"
					}
				},
				"description": "Container for regulation-specific filing information submitted.<br> Either disclaimMessageSet or referenceMessageSet or fullMessageSet required to be passed.<br>"
