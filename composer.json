{
    "name": "mariopereira/fedex",
    "description": "A PHP interface to the Fedex's APIs",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "autoload": {
        "psr-4": {
            "Mariopereira\\Fedex\\": "src/"
        }
    },
    "authors": [
        {
            "name": "Mário Pereira",
            "email": "bin.to.hex@gmail.com"
        }
    ],
    "require": {
        "php": ">=7.4",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpdocumentor/shim": "^3.10",
        "phpunit/phpunit": "^9.6"
    },
    "autoload-dev": {
        "psr-4": {
            "Mariopereira\\Fedex\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "allow-plugins": {
            "phpdocumentor/shim": true
        },
        "platform": {
            "php": "7.4.0"
        }
    }
}
